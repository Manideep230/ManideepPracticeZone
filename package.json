{
  "name": "manideep-practice-zone",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive MongoDB Learning & Practice Platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm --workspace=client run dev",
    "dev:server": "npm --workspace=server run dev",
    "build": "npm --workspace=client run build",
    "vercel-build": "npm --workspace=client run build",
    "install:all": "npm install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "json5": "^2.2.3",
    "mongodb": "^6.9.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
